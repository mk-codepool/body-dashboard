# -----------------------------------------------------------------------------
# Body Dashboard - Wzorzec Konfiguracji Środowiskowej (.env.example)
# Skopiuj ten plik jako `.env` i uzupełnij swoimi danymi.
# -----------------------------------------------------------------------------

# Google OAuth 2.0 Credentials (z Google Cloud Console)
GOOGLE_CLIENT_ID=twoj-klient-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=twoj-sekret-klienta

# Konfiguracja Portu API (lokalnie 3000, Render ustawia 10000)
PORT=3000

# Trwały Magazyn Danych MongoDB (np. darmowy klaster MongoDB Atlas M0)
# Wymagany na Renderze ze względu na ulotny system plików (ephemeral disk).
# Gdy brak tej zmiennej, backend używa bezpiecznie lokalnych plików JSON w data/users/.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/body_dashboard?retryWrites=true&w=majority
MONGODB_DB_NAME=body_dashboard
